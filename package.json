{
  "name": "dsh-project-guard",
  "version": "1.1.0",
  "description": "Consequence analysis for DeepSeek Harness: it says what an extra-permission call costs you — the device, your delegated authority, your wider interests. State-based, not guessed.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "index.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "cordis-plugin",
    "plugin",
    "permissions",
    "approval",
    "sandbox",
    "guard",
    "safety",
    "consequence-analysis",
    "human-oversight",
    "informed-execution"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inceptzws/dsh-project-guard.git"
  }
}
